# Copy to config/.env for local execution. Keep real credentials out of version control.

# Anthropic models
MORNING_BRIEF_SELECTION_MODEL=claude-haiku-4-5
MORNING_BRIEF_EXPLANATION_MODEL=claude-sonnet-4-5-20250929
# Optional when ANTHROPIC_API_KEY is already exported.
MORNING_BRIEF_ANTHROPIC_API_KEY=""
MORNING_BRIEF_SELECTION_MAX_TOKENS=1000
MORNING_BRIEF_EXPLANATION_MAX_TOKENS=6000
MORNING_BRIEF_AGENT_RETRIES=1
MORNING_BRIEF_MODEL_REQUEST_LIMIT=2

# Brief content
MORNING_BRIEF_INTERESTS=Applied AI engineering, agents, evaluation, and useful research
MORNING_BRIEF_SOURCE_NAMES=["tldr"]
MORNING_BRIEF_TOPIC_COUNT=5
MORNING_BRIEF_MAX_AGE_HOURS=96
MORNING_BRIEF_SOURCE_CONTENT_MIN_CHARS=200
MORNING_BRIEF_SOURCE_CONTENT_MAX_CHARS=16000
MORNING_BRIEF_SOURCE_HOSTS=["www.anthropic.com","anthropic.com","openai.com","huggingface.co","arxiv.org","github.com","raw.githubusercontent.com","deepmind.google","research.google","blog.google","x.ai","www.testingcatalog.com","www.interconnects.ai","devin.ai","www.alphaxiv.org","www.aikido.dev"]

# Runtime limits
MORNING_BRIEF_HTTP_TIMEOUT_SECONDS=20
MORNING_BRIEF_MODEL_TIMEOUT_SECONDS=130
MORNING_BRIEF_PIPELINE_TIMEOUT_SECONDS=420
MORNING_BRIEF_FETCH_TIMEOUT_SECONDS=30
MORNING_BRIEF_SELECTION_TIMEOUT_SECONDS=45
MORNING_BRIEF_ENRICHMENT_TIMEOUT_SECONDS=20
MORNING_BRIEF_EXPLANATION_TIMEOUT_SECONDS=260

# Email delivery
MORNING_BRIEF_SEND_EMAIL=false
MORNING_BRIEF_EMAIL_SUBJECT=Your daily AI learning brief
MORNING_BRIEF_SENDER=
MORNING_BRIEF_RECIPIENTS=[]
MORNING_BRIEF_SMTP_HOST=localhost
MORNING_BRIEF_SMTP_PORT=587
MORNING_BRIEF_SMTP_START_TLS=true
MORNING_BRIEF_SMTP_USE_TLS=false
MORNING_BRIEF_SMTP_TIMEOUT_SECONDS=30
MORNING_BRIEF_SMTP_USERNAME=
MORNING_BRIEF_SMTP_PASSWORD=
