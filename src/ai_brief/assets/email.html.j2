<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AI Learning Brief</title>
  </head>
  <body style="margin:0;background:#f4f7fb;color:#172033;font-family:Arial,Helvetica,sans-serif;line-height:1.55;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
      Your daily AI learning brief: {{ lessons | length }} useful {{ 'idea' if lessons | length == 1 else 'ideas' }} explained clearly.
    </div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td style="padding:32px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:720px;margin:0 auto;">
            <tr>
              <td style="padding:28px 32px;background:#172033;border-radius:18px 18px 0 0;color:#ffffff;">
                <p style="margin:0 0 8px;color:#a8c7ff;font-size:12px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;">Daily learning brief</p>
                <h1 style="margin:0;font-size:30px;line-height:1.2;">AI ideas worth your attention</h1>
                <p style="margin:12px 0 0;color:#dce6f7;font-size:15px;">Collected on {{ issue.collected_at.date().isoformat() }}</p>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px;background:#ffffff;">
                {% for lesson in lessons %}
                {% set story = stories[lesson.story_id] %}
                <article style="padding:0 0 28px;margin:0 0 28px;border-bottom:1px solid #e4e9f2;">
                  <p style="margin:0 0 8px;color:#5272a5;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Topic {{ loop.index }}</p>
                  <h2 style="margin:0 0 16px;color:#172033;font-size:23px;line-height:1.25;">{{ lesson.headline }}</h2>
                  <h3 style="margin:18px 0 5px;color:#172033;font-size:14px;">What happened</h3>
                  <p style="margin:0;color:#39465c;">{{ lesson.what_happened }}</p>
                  <h3 style="margin:18px 0 5px;color:#172033;font-size:14px;">Why it matters</h3>
                  <p style="margin:0;color:#39465c;">{{ lesson.why_it_matters }}</p>
                  <div style="margin:18px 0;padding:16px 18px;background:#eef4ff;border-left:4px solid #4f7edb;border-radius:8px;">
                    <p style="margin:0 0 5px;color:#2f5fa8;font-size:13px;font-weight:bold;">{{ lesson.concept }}</p>
                    <p style="margin:0;color:#263957;">{{ lesson.explanation }}</p>
                  </div>
                  <h3 style="margin:18px 0 5px;color:#172033;font-size:14px;">Example</h3>
                  <p style="margin:0;color:#39465c;">{{ lesson.example }}</p>
                  <h3 style="margin:18px 0 5px;color:#172033;font-size:14px;">Takeaway</h3>
                  <p style="margin:0;color:#39465c;">{{ lesson.takeaway }}</p>
                  <p style="margin:18px 0 0;font-size:14px;">
                    <a href="{{ story.url }}" style="color:#2f65b0;font-weight:bold;">Read: {{ story.title }}&nbsp;→</a>
                  </p>
                  <p style="font-size:12px;color:#6b7587;">Via <a href="{{ story.source_url }}">{{ story.source }}</a> · {{ story.published_at.date().isoformat() }}</p>
                  {% if not story.content %}
                  <p style="margin:10px 0 0;color:#6b7587;font-size:12px;font-style:italic;">Based on the {{ story.source }} summary; the original article was not retrieved.</p>
                  {% endif %}
                </article>
                {% endfor %}
              </td>
            </tr>
            <tr>
              <td style="padding:22px 32px;background:#eef2f7;border-radius:0 0 18px 18px;color:#6b7587;font-size:12px;">
                <p style="margin:0;">Generated explanations can contain mistakes. Check the linked sources before acting.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
